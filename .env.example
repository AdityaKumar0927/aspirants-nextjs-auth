# Copy to .env and fill in real values. NEVER commit real credentials —
# every value below is a placeholder.

# PostgreSQL (e.g. Vercel Postgres / Neon)
POSTGRES_PRISMA_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth app (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Generate one: `openssl rand -hex 32` or https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-hex-string

## Only required for localhost
NEXTAUTH_URL=http://localhost:3000

# OpenAI — used for the AI hint endpoint and the PDF question import pipeline
OPENAI_API_KEY=sk-...
# Vision-capable model used by /api/import/extract (default: gpt-4o)
OPENAI_EXTRACTION_MODEL=gpt-4o
# Model used by the /api/openai hint endpoint (default: gpt-4o-mini)
OPENAI_HINT_MODEL=gpt-4o-mini

# Allowed browser origin for the AI hint endpoint (your deployed URL)
ALLOWED_ORIGIN=http://localhost:3000

# Upstash Redis — rate limiting (optional in development; endpoints that use
# it fail open locally except /api/openai and /api/notes which require it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
REDIS_TOKEN=

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
