# Copy to .env and fill in real values. NEVER commit real credentials —
# every value below is a placeholder.

# PostgreSQL (e.g. Vercel Postgres / Neon)
POSTGRES_PRISMA_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth app (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Generate one: `openssl rand -hex 32` or https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-hex-string

## Only required for localhost
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI providers — power the STEM hint endpoint (/api/openai) and the PDF
# question import pipeline (/api/import/extract).
#
# Resolution (see lib/ai.ts): set AI_PROVIDER to pin one provider, or leave it
# "auto" (default) to prefer the free Gemini tier, then Groq (hints only),
# then OpenAI. Provide a key for whichever you want; nothing breaks if a given
# provider's key is absent — it's simply skipped in the fallback chain.
#   auto | gemini | groq | openai
AI_PROVIDER=auto

# Google Gemini — free tier covers both vision extraction and hints.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # accepted as an alternative to GEMINI_API_KEY
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_HINT_MODEL=gemini-2.5-flash

# Groq — very fast free tier, hints only (no vision model wired here).
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_HINT_MODEL=llama-3.3-70b-versatile

# OpenAI — paid fallback / escape hatch. Used when no free key is set, or when
# the free providers fail (extraction falls back to it automatically).
OPENAI_API_KEY=sk-...
# Vision-capable model used by /api/import/extract (default: gpt-4o)
OPENAI_EXTRACTION_MODEL=gpt-4o
# Model used by the /api/openai hint endpoint (default: gpt-4o-mini)
OPENAI_HINT_MODEL=gpt-4o-mini

# Allowed browser origin for the AI hint endpoint (your deployed URL)
ALLOWED_ORIGIN=http://localhost:3000

# Upstash Redis — rate limiting (optional in development; endpoints that use
# it fail open locally except /api/openai and /api/notes which require it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
REDIS_TOKEN=

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
