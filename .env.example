# Copy to .env and fill in real values. NEVER commit real credentials —
# every value below is a placeholder.

# PostgreSQL (e.g. Vercel Postgres / Neon)
POSTGRES_PRISMA_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google OAuth app (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Signs/encrypts the session JWT. REQUIRED in production — NextAuth refuses to
# start without it. Use a strong, unique random value:
#   `openssl rand -hex 32`  (or https://generate-secret.vercel.app/32)
NEXTAUTH_SECRET=replace-with-a-random-32-byte-hex-string

# The canonical site URL. In production set this to your real https origin (e.g.
# https://penwise-git-main-aditya-kumar-s-projects.vercel.app) so OAuth callbacks and the session cookie are pinned to
# it instead of trusting the incoming Host header.
NEXTAUTH_URL=http://localhost:3000

# Local-only escape hatch: sign in as an EXISTING user by email without Google
# OAuth. Honoured ONLY when NODE_ENV!=production AND DEV_LOGIN=1, so it can never
# activate on a deploy. Leave UNSET — never set this in production.
# DEV_LOGIN=1

# ---------------------------------------------------------------------------
# AI providers — power the STEM hint endpoint (/api/openai) and the PDF
# question import pipeline (/api/import/extract).
#
# Resolution (see lib/ai.ts): set AI_PROVIDER to pin one provider, or leave it
# "auto" (default) to prefer the free Gemini tier, then Groq (hints only),
# then OpenAI. Provide a key for whichever you want; nothing breaks if a given
# provider's key is absent — it's simply skipped in the fallback chain.
#   auto | gemini | groq | openai
AI_PROVIDER=auto

# Google Gemini — free tier covers both vision extraction and hints.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   # accepted as an alternative to GEMINI_API_KEY
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_HINT_MODEL=gemini-2.5-flash

# Groq — very fast free tier, hints only (no vision model wired here).
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_HINT_MODEL=llama-3.3-70b-versatile

# OpenAI — paid fallback / escape hatch. Used when no free key is set, or when
# the free providers fail (extraction falls back to it automatically).
OPENAI_API_KEY=sk-...
# Vision-capable model used by /api/import/extract (default: gpt-4o)
OPENAI_EXTRACTION_MODEL=gpt-4o
# Model used by the /api/openai hint endpoint (default: gpt-4o-mini)
OPENAI_HINT_MODEL=gpt-4o-mini

# Allowed browser origin for the AI hint endpoint (your deployed URL)
ALLOWED_ORIGIN=http://localhost:3000

# Upstash Redis — rate limiting (optional in development; endpoints that use
# it fail open locally except /api/openai which requires it). The shared
# limiter (lib/rate-limit.ts) also reads the KV_REST_API_* names that the Vercel
# Marketplace Redis/KV integration provisions, so a free Vercel-integrated Redis
# works with no code change — set EITHER pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=        # set automatically by the Vercel Redis/KV integration
# KV_REST_API_TOKEN=
REDIS_URL=
REDIS_TOKEN=

# Cloudflare Turnstile — free, privacy-friendly CAPTCHA on public forms (contact).
# Optional: leave blank to disable (forms work without it). Get keys free at
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# DPDP (India) compliance
#
# Named Grievance Officer / Data Protection contact published in the privacy
# policy, consent notice and grievance page (required by DPDP Rules 2025).
GRIEVANCE_OFFICER_NAME=Grievance Officer
GRIEVANCE_OFFICER_EMAIL=aspirants.contact@gmail.com

# Transactional email (parental-consent links, data-request acknowledgements).
# If RESEND_API_KEY is unset, emails are logged to the server console instead of
# being sent — flows remain testable locally. Key: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Penwise <onboarding@resend.dev>

# Public base URL used to build links inside emails (parental-consent verify).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for scheduled jobs (Vercel Cron). When set, Vercel attaches
# `Authorization: Bearer ${CRON_SECRET}` to cron requests; the audit-log purge
# (vercel.json → GET /api/admin/audit/purge, daily) requires it to match.
CRON_SECRET=

# Google Analytics 4 measurement id (optional). Loaded ONLY after a user opts in
# via the cookie banner, and never for users who declare they are under 18.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
