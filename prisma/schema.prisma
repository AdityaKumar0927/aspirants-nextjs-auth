generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ======================================================
// 1) Auth & User Models
// ======================================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String                  @id @default(cuid())
  name          String?
  email         String?                 @unique
  emailVerified DateTime?
  image         String?
  subscribed    Boolean                 @default(false)

  // Auth & user-related
  accounts      Account[]
  sessions      Session[]

  // Existing relations
  progresses    UserProgress[]
  notes         Note[]
  performances  UserPerformance[]
  answers       UserAnswer[]
  settings      UserSettings?
  issues        Issue[]                 @relation("UserIssues")
  policyAgreements UserPolicyAgreement[]
  role          UserRole                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        String                  @default("member")
  applications  Application[]
  feedback      Feedback[]
}

model UserRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  users       User[]
}

model UserPolicyAgreement {
  id         String    @id @default(cuid())
  userId     String
  policyName String
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, policyName])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  username String
  email    String
  bio      String
  urls     Json
  name     String
  language String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ======================================================
// 2) Enums & Models for Questions
// ======================================================
enum QuestionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Question {
  id                   Int               @id @default(autoincrement())
  questionId           String            @unique
  examGroup            String?
  country              String?
  exam                 String?
  key                  String?
  date                 DateTime?
  description          String?
  isMemoryBased        Boolean?
  isOnline             Boolean?
  languages            String[]
  title                String?
  year                 Int?
  pyqOutOfSyllabus     Int?
  pyqTotal             Int?
  pyqPrivate           Int?
  pyqPublic            Int?

  examId               Int?
  subjectGroup         String?
  chapterGroup         String?
  chapter              String?
  topicName            String?
  examDate             DateTime?
  content              Json?
  permalink            String?
  paperId              String?
  isOutOfSyllabus      Boolean?
  isBonus              Boolean?

  text                 String
  subject              String?
  topic                String?
  subtopic             String?
  difficulty           String?
  type                 String?
  marks                Float?
  negMarks             Float?
  options              String[]
  correctOption        String?
  markscheme           String?
  correctAttempts      String?
  wrongAttempts        String?
  averageTimeTaken     String?
  lastAttempted        DateTime?
  diagramUrl           String?
  customTag            String?
  explanation          Json?
  reviewed             Boolean?
  completed            Boolean?

  paperTitle           String?
  timeAllotted         Int?
  updatedTime          Int?
  updatedBy            String?
  source               String?
  peerSolvedPercentage Float?
  linkedResources      Json?
  commonMistakes       Json?
  discussionLink       String?
  parentQuestionId     Int?
  difficultyRating     Float?
  yearKey              String?

  status               QuestionStatus    @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Self-relation (for multi-part Qs)
  parentQuestion       Question?         @relation("ParentChild", fields: [parentQuestionId], references: [id])
  children             Question[]        @relation("ParentChild")

  // Relations to other models
  notes                Note[]            @relation("QuestionNotes")
  progresses           UserProgress[]
  answers              UserAnswer[]
  userPerformances     UserPerformance[]
  issues               Issue[]
  examModel            Exam?             @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String    @db.Text
  type       NoteType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation("QuestionNotes", fields: [questionId], references: [questionId], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
}

enum NoteType {
  TEXT
  IMAGE
  STYLUS
  VOICE
}

model UserProgress {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  completed     Boolean   @default(false)
  reviewed      Boolean   @default(false)
  lastAttempted DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question  @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserAnswer {
  id             String   @id @default(cuid())
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserPerformance {
  id                      Int      @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question                Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

// ======================================================
// 3) Exam & Pyq
// ======================================================
model Exam {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  examGroup     String?
  country       String?
  exam          String?
  date          DateTime?
  description   String?
  isMemoryBased Boolean?
  isOnline      Boolean?
  languages     String[]
  title         String
  year          Int?

  pyq           Pyq[]
  questions     Question[]

  @@index([key])
}

model Pyq {
  id              Int    @id @default(autoincrement())
  out_of_syllabus Int?
  total           Int?
  private         Int?
  public          Int?
  examId          Int

  exam            Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
}

// ======================================================
// 4) Issue, Application, Feedback
// ======================================================
model Issue {
  id          String       @id @default(cuid())
  title       String
  description String
  status      IssueStatus  @default(OPEN)
  priority    IssuePriority
  area        IssueArea
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade, name: "UserIssues")
  questionId  String?
  question    Question?    @relation(fields: [questionId], references: [questionId], onDelete: SetNull)
}

enum IssueArea {
  CONTENT
  UI
  BUG
  FEATURE
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  name       String
  email      String
  role       ApplicationRole
  experience String
  motivation String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
}

enum ApplicationRole {
  VOLUNTEER
  MODERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  emoji     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ======================================================
// 5) NEW: CustomQuestionBank (identical to `Question`)
// ======================================================
model CustomQuestionBank {
  id                   Int               @id @default(autoincrement())
  questionId           String            @unique
  examGroup            String?
  country              String?
  exam                 String?
  key                  String?
  date                 DateTime?
  description          String?
  isMemoryBased        Boolean?
  isOnline             Boolean?
  languages            String[]
  title                String?
  year                 Int?
  pyqOutOfSyllabus     Int?
  pyqTotal             Int?
  pyqPrivate           Int?
  pyqPublic            Int?

  examId               Int?
  subjectGroup         String?
  chapterGroup         String?
  chapter              String?
  topicName            String?
  examDate             DateTime?
  content              Json?
  permalink            String?
  paperId              String?
  isOutOfSyllabus      Boolean?
  isBonus              Boolean?

  text                 String
  subject              String?
  topic                String?
  subtopic             String?
  difficulty           String?
  type                 String?
  marks                Float?
  negMarks             Float?
  options              String[]
  correctOption        String?
  markscheme           String?
  correctAttempts      String?
  wrongAttempts        String?
  averageTimeTaken     String?
  lastAttempted        DateTime?
  diagramUrl           String?
  customTag            String?
  explanation          Json?
  reviewed             Boolean?
  completed            Boolean?

  paperTitle           String?
  timeAllotted         Int?
  updatedTime          Int?
  updatedBy            String?
  source               String?
  peerSolvedPercentage Float?
  linkedResources      Json?
  commonMistakes       Json?
  discussionLink       String?
  parentQuestionId     Int?
  difficultyRating     Float?
  yearKey              String?

  status               QuestionStatus    @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Self-relation (multi-part custom Qs)
  parentQuestion       CustomQuestionBank?  @relation("ParentChild", fields: [parentQuestionId], references: [id])
  children             CustomQuestionBank[] @relation("ParentChild")
}
