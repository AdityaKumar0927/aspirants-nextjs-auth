generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  // Renamed from "User" to "user"
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AiUsageLog {
  id          String    @id @default(uuid())
  userId      String?
  usedService AiService
  textInput   String?
  pdfName     String?
  tokensUsed  Int       @default(0)
  cost        Float     @default(0)
  createdAt   DateTime  @default(now())
  User        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Application {
  id         String            @id @default(uuid())
  userId     String
  name       String
  email      String
  role       ApplicationRole
  experience String
  motivation String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  User       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exam {
  id            Int        @id @default(autoincrement())
  key           String     @unique
  examGroup     String?
  country       String?
  exam          String?
  date          DateTime?
  description   String?
  isMemoryBased Boolean?
  isOnline      Boolean?
  languages     String[]
  title         String
  year          Int?
  Pyq           Pyq[]
  Question      Question[]
}

model Feedback {
  id           String            @id @default(uuid())
  content      String
  emoji        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime
  userId       String
  feedbackType FeedbackType      @default(GENERAL)
  questionId   String?
  resolved     Boolean           @default(false)
  resolvedBy   String?
  // The submitter asked to stay anonymous: their identity is hidden from the
  // admin UI, but userId is retained so the clarification thread can still
  // route admin replies back to them.
  anonymous    Boolean           @default(false)
  status       FeedbackStatus    @default(OPEN)
  Question     Question?         @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     FeedbackMessage[]

  @@index([userId])
  @@index([questionId])
}

// One turn in the admin <-> submitter conversation on a piece of feedback.
// authorId is the userId of whoever wrote it (admin or submitter); it is a
// plain column (no FK) so messages survive either party's account deletion.
model FeedbackMessage {
  id         String   @id @default(uuid())
  feedbackId String
  fromAdmin  Boolean  @default(false)
  authorId   String
  content    String
  createdAt  DateTime @default(now())
  Feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model Issue {
  id           String        @id @default(uuid())
  title        String
  description  String
  status       IssueStatus   @default(OPEN)
  priority     IssuePriority
  area         IssueArea
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String
  questionId   String?
  resolvedById String?
  userNotified Boolean       @default(false)

  createdBy     User            @relation("Issue_createdByIdToUser", fields: [createdById], references: [id], onDelete: Cascade)
  question      Question?       @relation(fields: [questionId], references: [questionId], onDelete: SetNull)
  resolvedBy    User?           @relation("Issue_resolvedByIdToUser", fields: [resolvedById], references: [id], onDelete: SetNull)
  VolunteerTask VolunteerTask[]

  @@index([questionId])
}

model ModeratorLimit {
  id              String    @id @default(uuid())
  userId          String    @unique
  changesThisHour Int       @default(0)
  lastChangeHour  DateTime?
  User            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id         String    @id @default(uuid())
  title      String
  content    String
  type       NoteType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  questionId String?
  Question   Question? @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model Notification {
  id                String           @id @default(uuid())
  userId            String?
  title             String
  message           String
  type              NotificationType @default(INFO)
  read              Boolean          @default(false)
  createdAt         DateTime         @default(now())
  relatedIssueId    String?
  relatedFeedbackId String?
  relatedQuestionId String?
  User              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Pyq {
  id              Int  @id @default(autoincrement())
  out_of_syllabus Int?
  total           Int?
  private         Int?
  public          Int?
  examId          Int
  Exam            Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Question {
  id                   Int            @id @default(autoincrement())
  questionId           String         @unique
  examGroup            String?
  country              String?
  exam                 String?
  key                  String?
  date                 DateTime?
  description          String?
  isMemoryBased        Boolean?
  isOnline             Boolean?
  languages            String[]
  title                String?
  year                 Int?
  pyqOutOfSyllabus     Int?
  pyqTotal             Int?
  pyqPrivate           Int?
  pyqPublic            Int?
  text                 String
  subject              String?
  topic                String?
  subtopic             String?
  difficulty           String?
  type                 String?
  marks                Float?
  negMarks             Float?
  options              String[]
  correctOption        String?
  // Typed answers for non-single-choice questions:
  correctOptions       String[]       @default([]) // "Multiple Correct" questions
  answerText           String? // "Integer"/"Subjective" model answer
  answerMin            Float? // "Numerical" accepted range (inclusive)
  answerMax            Float?
  markscheme           String?
  correctAttempts      String?
  wrongAttempts        String?
  averageTimeTaken     String?
  lastAttempted        DateTime?
  diagramUrl           String?
  customTag            String?
  explanation          Json?
  reviewed             Boolean?
  completed            Boolean?
  paperTitle           String?
  timeAllotted         Int?
  updatedTime          Int?
  updatedBy            String?
  source               String?
  peerSolvedPercentage Float?
  linkedResources      Json?
  commonMistakes       Json?
  discussionLink       String?
  parentQuestionId     Int?
  difficultyRating     Float?
  yearKey              String?
  status               QuestionStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  importJobId          String?
  chapter              String?
  chapterGroup         String?
  content              Json?
  examDate             DateTime?
  examId               Int?
  isBonus              Boolean?
  isOutOfSyllabus      Boolean?
  paperId              String?
  permalink            String?
  subjectGroup         String?
  topicName            String?
  archetypeId          String? // ML-derived recurring-question cluster (see QuestionArchetype)

  // Relations
  Feedback        Feedback[]
  Issue           Issue[]
  Note            Note[]
  Exam            Exam?              @relation(fields: [examId], references: [id], onDelete: Cascade)
  Question        Question?          @relation("QuestionToQuestion", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  other_Question  Question[]         @relation("QuestionToQuestion")
  UserAnswer      UserAnswer[]
  UserPerformance UserPerformance[]
  UserProgress    UserProgress[]
  ImportJob       ImportJob?         @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  Archetype       QuestionArchetype? @relation(fields: [archetypeId], references: [id], onDelete: SetNull)

  // If you have solutions
  solutions Solution[]

  @@index([importJobId])
  @@index([parentQuestionId])
  @@index([archetypeId])
  // Indexes for the question-bank filter/cascade query (status is filtered on
  // every read; exam/subject/topic/year are the primary facets).
  @@index([status])
  @@index([exam])
  @@index([subject])
  @@index([topic])
  @@index([year])
}

// Tracks a "PDF -> question bank" import run (who imported what, when, and how it went).
model ImportJob {
  id            String          @id @default(uuid())
  userId        String
  fileName      String
  status        ImportJobStatus @default(PROCESSING)
  pageCount     Int             @default(0)
  questionCount Int             @default(0)
  tokensUsed    Int             @default(0)
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  User          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  Question      Question[]

  @@index([userId])
}

enum ImportJobStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserMockExam {
  id        String   @id @default(uuid())
  userId    String
  exam      String?
  year      Int?
  shift     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completed Boolean  @default(false)

  results Json?
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id               String            @id @default(uuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  subscribed       Boolean           @default(false)
  roleId           String            @default("member")
  changesMade      Int               @default(0)
  createdAt        DateTime          @default(now())
  subscriptionTier SubscriptionTier? @default(MEMBER)
  updatedAt        DateTime          @default(now())
  verifiedTeacher  Boolean           @default(false)
  likedSolutionIds String[]          @default([]) // solutions this user has liked (prevents like-spam)

  // --- DPDP (India) compliance ---
  dateOfBirth         DateTime? // self-declared at onboarding
  isMinor             Boolean? // derived from dateOfBirth (< 18); null = not yet captured
  onboardingComplete  Boolean   @default(false) // DOB + consent notice accepted
  analyticsConsent    Boolean   @default(false) // server-side mirror of cookie/analytics consent
  deletionRequestedAt DateTime? // erasure-in-progress marker

  Account                        Account[]
  AiUsageLog                     AiUsageLog[]
  ImportJob                      ImportJob[]
  Application                    Application[]
  Feedback                       Feedback[]
  Issue_Issue_createdByIdToUser  Issue[]               @relation("Issue_createdByIdToUser")
  Issue_Issue_resolvedByIdToUser Issue[]               @relation("Issue_resolvedByIdToUser")
  ModeratorLimit                 ModeratorLimit?
  Note                           Note[]
  Notification                   Notification[]
  Session                        Session[]
  UserRole                       UserRole              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  UserAnswer                     UserAnswer[]
  UserPerformance                UserPerformance[]
  UserPolicyAgreement            UserPolicyAgreement[]
  UserProgress                   UserProgress[]
  UserSettings                   UserSettings?
  VolunteerTask                  VolunteerTask[]
  userMockExams                  UserMockExam[]

  // If a user can author solutions
  solutionsAuthored Solution[]     @relation("UserToSolutionsAuthored")
  solutionLikes     SolutionLike[]

  // DPDP relations
  ConsentRecord   ConsentRecord[]
  ParentalConsent ParentalConsent?
  DataRequest     DataRequest[]

  // Feature requests (public roadmap board)
  FeatureRequest        FeatureRequest[]
  FeatureRequestVote    FeatureRequestVote[]
  FeatureRequestComment FeatureRequestComment[]

  // Study planner (server-synced)
  StudyPlan StudyPlan?

  // "Bring your own material" — student-generated private question banks
  UserBank UserBank[]

  // Keystone — saved lessons / revision sets with spaced-return scheduling
  KeystoneItem KeystoneItem[]
}

/// Keystone — a saved lesson or revision set with spaced-return scheduling,
/// synced from the on-device shelf so it follows a signed-in student across
/// devices. `data` / `progress` hold the same JSON the client player uses.
model KeystoneItem {
  id            String    @id
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          String // "learning" | "revision"
  title         String
  subject       String?
  data          Json
  progress      Json?
  reviewCount   Int       @default(0)
  lastStudiedAt DateTime?
  dueAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model UserAnswer {
  id             String   @id @default(uuid())
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  Question       Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserPerformance {
  id                      Int      @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime
  Question                Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserPolicyAgreement {
  id         String    @id @default(uuid())
  userId     String
  policyName String
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyName])
  @@index([userId])
}

model UserProgress {
  id            String    @id @default(uuid())
  userId        String
  questionId    String
  completed     Boolean   @default(false)
  reviewed      Boolean   @default(false)
  lastAttempted DateTime?
  Question      Question  @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserRole {
  id          String @id @default(uuid())
  name        String @unique
  permissions Json
  User        User[]
}

model UserSettings {
  id                   String  @id @default(uuid())
  userId               String  @unique
  username             String
  email                String
  bio                  String
  urls                 Json
  name                 String
  language             String
  // Merit-list (leaderboard) visibility preferences.
  leaderboardOptOut    Boolean @default(false) // hide from the rankings entirely
  leaderboardAnonymous Boolean @default(false) // appear, but as "Anonymous"
  leaderboardName      String? // custom display name for the rankings
  User                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VolunteerTask {
  id          String   @id @default(uuid())
  volunteerId String
  issueId     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  Issue       Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  User        User     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([issueId])
}

enum AiService {
  GOOGLE_OCR
  GPT_COMPLETION
  GPT_EDIT
  OTHER
}

enum ApplicationRole {
  VOLUNTEER
  MODERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackType {
  GENERAL
  QUESTION_ISSUE
}

enum FeedbackStatus {
  OPEN // needs admin attention (new, or the user just replied)
  AWAITING_USER // admin asked for clarification, waiting on the submitter
  RESOLVED
}

enum IssueArea {
  CONTENT
  UI
  BUG
  FEATURE
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NoteType {
  TEXT
  IMAGE
  STYLUS
  VOICE
}

enum NotificationType {
  INFO
  ISSUE_RESOLVED
  ADMIN_ANNOUNCEMENT
  FEEDBACK_RESPONSE
  SYSTEM
}

enum QuestionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum SubscriptionTier {
  FREE
  MEMBER
  PREMIUM
  VOLUNTEER
  MODERATOR
  ADMIN
  INSTITUTION
}

model Solution {
  id         String   @id @default(uuid())
  questionId String
  parentId   String?
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  likes      Int      @default(0)

  // Relationship to Question
  question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  // Self-relation for replies
  parent  Solution?  @relation("SolutionReplies", fields: [parentId], references: [id])
  replies Solution[] @relation("SolutionReplies")

  // If you want to track the user who wrote the solution
  author User? @relation("UserToSolutionsAuthored", fields: [authorId], references: [id], onDelete: SetNull)

  likedBy SolutionLike[]
}

// One row per (user, solution) like — the like COUNT is derived from this, so
// it can never be inflated by replayed toggle requests.
model SolutionLike {
  id         String   @id @default(uuid())
  userId     String
  solutionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  solution   Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([userId, solutionId])
  @@index([solutionId])
}

// ===========================================================================
// DPDP (India) compliance models
// ===========================================================================

// Append-only, versioned, withdrawable purpose consent. The CURRENT consent
// state for a (userId, purpose) is the most recent row — withdrawal is a new
// row with granted=false, so the full history is preserved for audit.
model ConsentRecord {
  id             String         @id @default(uuid())
  userId         String
  purpose        ConsentPurpose
  consentVersion String // notice version in force when consent was given (see CONSENT_VERSION)
  granted        Boolean
  source         String // "onboarding" | "cookie-banner" | "privacy-dashboard" | "parental"
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  User           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Verifiable parental consent for under-18 users (one active record per minor).
// Only the SHA-256 hash of the emailed token is stored, never the raw token.
model ParentalConsent {
  id          String                @id @default(uuid())
  userId      String                @unique
  parentEmail String
  parentName  String?
  tokenHash   String
  status      ParentalConsentStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  verifiedAt  DateTime?
  expiresAt   DateTime
  User        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

// Data-principal rights workflow (DSAR / grievance). dueAt = createdAt + 90 days.
model DataRequest {
  id         String            @id @default(uuid())
  userId     String
  type       DataRequestType
  status     DataRequestStatus @default(OPEN)
  message    String?
  response   String?
  dueAt      DateTime
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?
  resolvedBy String?
  User       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// Reasonable-security audit log (DPDP Rule 6). `userId` is a plain column with
// NO foreign-key relation, so audit entries SURVIVE account erasure — we must
// be able to prove a deletion happened after the user row is gone. Retained for
// one year (see /api/admin/audit/purge).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum ConsentPurpose {
  ESSENTIAL
  ANALYTICS
  PROFILING
  MARKETING
  AI_PROCESSING
}

enum ParentalConsentStatus {
  PENDING
  VERIFIED
  EXPIRED
  REVOKED
}

enum DataRequestType {
  ACCESS
  CORRECTION
  ERASURE
  GRIEVANCE
  WITHDRAW_CONSENT
}

enum DataRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

// A cluster of near-identical past-paper questions — a recurring "archetype"
// (e.g. the same projectile-motion template asked across years). Produced
// offline by the embeddings + clustering enrichment job (scripts/) and surfaced
// in the Exam Blueprint. Also the seed layer for the concept knowledge graph.
model QuestionArchetype {
  id                       String   @id @default(uuid())
  exam                     String
  subject                  String?
  chapter                  String?
  label                    String // representative (medoid) question text, truncated
  size                     Int // number of questions in the cluster
  distinctYears            Int // how many distinct years it appears in
  years                    Int[] // the years it appears in
  firstYear                Int?
  lastYear                 Int?
  representativeQuestionId String?
  createdAt                DateTime @default(now())

  Question Question[]

  @@index([exam])
  @@index([exam, distinctYears])
}

enum FeatureRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model FeatureRequest {
  id          String               @id @default(uuid())
  title       String
  description String
  status      FeatureRequestStatus @default(PENDING)
  category    String
  tags        String[]             @default([])
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  votes     FeatureRequestVote[]
  comments  FeatureRequestComment[]

  @@index([status])
  @@index([createdAt])
}

model FeatureRequestVote {
  id               String   @id @default(uuid())
  featureRequestId String
  userId           String
  createdAt        DateTime @default(now())

  featureRequest FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureRequestId, userId])
  @@index([featureRequestId])
}

model FeatureRequestComment {
  id               String   @id @default(uuid())
  featureRequestId String
  authorId         String
  content          String
  createdAt        DateTime @default(now())

  featureRequest FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([featureRequestId])
}

// One per user — holds the study-planner state ({ subjects, studySessions }) as
// JSON so it syncs across devices. Guests fall back to localStorage client-side.
model StudyPlan {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// "Bring your own material" — a student-generated, PRIVATE question bank built
// from JSON they produced in their own AI tool. Practiced as a question bank or
// taken as a timed mock exam. Owned by exactly one user (no sharing in v1).
model UserBank {
  id              String    @id @default(cuid())
  userId          String
  title           String
  description     String?
  sourceName      String? // the doc the student noted as the source (free text)
  defaultMode     String    @default("BANK") // "BANK" | "EXAM"
  examDurationMin Int? // for EXAM mode
  questionCount   Int       @default(0)
  lastResult      Json? // last ExamResultsType blob (size-capped at write time)
  lastTakenAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  User      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions UserBankQuestion[]

  @@index([userId])
}

// A single question inside a UserBank. Mirrors the gradable fields of Question
// so it flows straight through normalizeQuestion()/gradeAnswer(). Per-question
// practice state (completed/flagged) lives on the row because the bank has a
// single owner.
model UserBankQuestion {
  id             String   @id @default(cuid())
  bankId         String
  order          Int
  text           String
  type           String // canonical type (incl. "Fill Blanks")
  options        String[]
  correctOption  String?
  correctOptions String[]
  answerText     String?
  answerMin      Float?
  answerMax      Float?
  explanation    String? // markdown/LaTeX text
  markscheme     String?
  subject        String?
  topic          String?
  difficulty     String?
  marks          Float?
  negMarks       Float?
  completed      Boolean  @default(false)
  flagged        Boolean  @default(false)

  Bank UserBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
}
