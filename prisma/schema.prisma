generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AiUsageLog {
  id          String    @id
  userId      String?
  usedService AiService
  textInput   String?
  pdfName     String?
  tokensUsed  Int       @default(0)
  cost        Float     @default(0)
  createdAt   DateTime  @default(now())
  User        User?     @relation(fields: [userId], references: [id])
}

model Application {
  id         String            @id
  userId     String
  name       String
  email      String
  role       ApplicationRole
  experience String
  motivation String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime
  User       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
}

model Exam {
  id            Int        @id @default(autoincrement())
  key           String     @unique
  examGroup     String?
  country       String?
  exam          String?
  date          DateTime?
  description   String?
  isMemoryBased Boolean?
  isOnline      Boolean?
  languages     String[]
  title         String
  year          Int?
  Pyq           Pyq[]
  Question      Question[]
}

model Feedback {
  id           String       @id
  content      String
  emoji        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  userId       String
  feedbackType FeedbackType @default(GENERAL)
  questionId   String?
  resolved     Boolean      @default(false)
  resolvedBy   String?
  Question     Question?    @relation(fields: [questionId], references: [questionId])
  User         User         @relation(fields: [userId], references: [id])
}

model Issue {
  id                            String          @id
  title                         String
  description                   String
  status                        IssueStatus     @default(OPEN)
  priority                      IssuePriority
  area                          IssueArea
  createdAt                     DateTime        @default(now())
  updatedAt                     DateTime
  createdById                   String
  questionId                    String?
  resolvedById                  String?
  userNotified                  Boolean         @default(false)
  User_Issue_createdByIdToUser  User            @relation("Issue_createdByIdToUser", fields: [createdById], references: [id], onDelete: Cascade)
  Question                      Question?       @relation(fields: [questionId], references: [questionId])
  User_Issue_resolvedByIdToUser User?           @relation("Issue_resolvedByIdToUser", fields: [resolvedById], references: [id])
  VolunteerTask                 VolunteerTask[]
}

model ModeratorLimit {
  id              String    @id
  userId          String    @unique
  changesThisHour Int       @default(0)
  lastChangeHour  DateTime?
  User            User      @relation(fields: [userId], references: [id])
}

model Note {
  id         String    @id
  title      String
  content    String
  type       NoteType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  userId     String
  questionId String?
  Question   Question? @relation(fields: [questionId], references: [questionId])
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model Notification {
  id                String           @id
  userId            String?
  title             String
  message           String
  type              NotificationType @default(INFO)
  read              Boolean          @default(false)
  createdAt         DateTime         @default(now())
  relatedIssueId    String?
  relatedFeedbackId String?
  relatedQuestionId String?
  User              User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pyq {
  id              Int  @id @default(autoincrement())
  out_of_syllabus Int?
  total           Int?
  private         Int?
  public          Int?
  examId          Int
  Exam            Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Question {
  id                   Int               @id @default(autoincrement())
  questionId           String            @unique
  examGroup            String?
  country              String?
  exam                 String?
  key                  String?
  date                 DateTime?
  description          String?
  isMemoryBased        Boolean?
  isOnline             Boolean?
  languages            String[]
  title                String?
  year                 Int?
  pyqOutOfSyllabus     Int?
  pyqTotal             Int?
  pyqPrivate           Int?
  pyqPublic            Int?
  text                 String
  subject              String?
  topic                String?
  subtopic             String?
  difficulty           String?
  type                 String?
  marks                Float?
  negMarks             Float?
  options              String[]
  correctOption        String?
  markscheme           String?
  correctAttempts      String?
  wrongAttempts        String?
  averageTimeTaken     String?
  lastAttempted        DateTime?
  diagramUrl           String?
  customTag            String?
  explanation          Json?
  reviewed             Boolean?
  completed            Boolean?
  paperTitle           String?
  timeAllotted         Int?
  updatedTime          Int?
  updatedBy            String?
  source               String?
  peerSolvedPercentage Float?
  linkedResources      Json?
  commonMistakes       Json?
  discussionLink       String?
  parentQuestionId     Int?
  difficultyRating     Float?
  yearKey              String?
  status               QuestionStatus    @default(ACTIVE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  chapter              String?
  chapterGroup         String?
  content              Json?
  examDate             DateTime?
  examId               Int?
  isBonus              Boolean?
  isOutOfSyllabus      Boolean?
  paperId              String?
  permalink            String?
  subjectGroup         String?
  topicName            String?
  Feedback             Feedback[]
  Issue                Issue[]
  Note                 Note[]
  Exam                 Exam?             @relation(fields: [examId], references: [id], onDelete: Cascade)
  Question             Question?         @relation("QuestionToQuestion", fields: [parentQuestionId], references: [id])
  other_Question       Question[]        @relation("QuestionToQuestion")
  UserAnswer           UserAnswer[]
  UserPerformance      UserPerformance[]
  UserProgress         UserProgress[]
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                             String                @id
  name                           String?
  email                          String?               @unique
  emailVerified                  DateTime?
  image                          String?
  subscribed                     Boolean               @default(false)
  roleId                         String                @default("member")
  changesMade                    Int                   @default(0)
  createdAt                      DateTime              @default(now())
  subscriptionTier               SubscriptionTier?     @default(MEMBER)
  updatedAt                      DateTime              @default(now())
  verifiedTeacher                Boolean               @default(false)
  Account                        Account[]
  AiUsageLog                     AiUsageLog[]
  Application                    Application[]
  Feedback                       Feedback[]
  Issue_Issue_createdByIdToUser  Issue[]               @relation("Issue_createdByIdToUser")
  Issue_Issue_resolvedByIdToUser Issue[]               @relation("Issue_resolvedByIdToUser")
  ModeratorLimit                 ModeratorLimit?
  Note                           Note[]
  Notification                   Notification[]
  Session                        Session[]
  UserRole                       UserRole              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  UserAnswer                     UserAnswer[]
  UserPerformance                UserPerformance[]
  UserPolicyAgreement            UserPolicyAgreement[]
  UserProgress                   UserProgress[]
  UserSettings                   UserSettings?
  VolunteerTask                  VolunteerTask[]
}

model UserAnswer {
  id             String   @id
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  Question       Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserPerformance {
  id                      Int      @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime
  Question                Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserPolicyAgreement {
  id         String    @id
  userId     String
  policyName String
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyName])
  @@index([userId])
}

model UserProgress {
  id            String    @id
  userId        String
  questionId    String
  completed     Boolean   @default(false)
  reviewed      Boolean   @default(false)
  lastAttempted DateTime?
  Question      Question  @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserRole {
  id          String @id
  name        String @unique
  permissions Json
  User        User[]
}

model UserSettings {
  id       String @id
  userId   String @unique
  username String
  email    String
  bio      String
  urls     Json
  name     String
  language String
  User     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VolunteerTask {
  id          String   @id
  volunteerId String
  issueId     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  Issue       Issue?   @relation(fields: [issueId], references: [id])
  User        User     @relation(fields: [volunteerId], references: [id])
}

enum AiService {
  GOOGLE_OCR
  GPT_COMPLETION
  GPT_EDIT
  OTHER
}

enum ApplicationRole {
  VOLUNTEER
  MODERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackType {
  GENERAL
  QUESTION_ISSUE
}

enum IssueArea {
  CONTENT
  UI
  BUG
  FEATURE
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NoteType {
  TEXT
  IMAGE
  STYLUS
  VOICE
}

enum NotificationType {
  INFO
  ISSUE_RESOLVED
  ADMIN_ANNOUNCEMENT
  FEEDBACK_RESPONSE
  SYSTEM
}

enum QuestionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum SubscriptionTier {
  FREE
  MEMBER
  PREMIUM
  VOLUNTEER
  MODERATOR
  ADMIN
  INSTITUTION
}
