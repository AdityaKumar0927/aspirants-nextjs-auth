generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  subscribed             Boolean                 @default(false)
  accounts               Account[]
  sessions               Session[]
  progresses             UserProgress[]
  notes                  Note[]
  performances           UserPerformance[]
  answers                UserAnswer[]
  settings               UserSettings?
  questionBanks          CustomQuestionBank[]
  customNotes            CustomNote[]
  customUserProgresses   CustomUserProgress[]
  customUserAnswers      CustomUserAnswer[]
  customUserPerformances CustomUserPerformance[]
  issues                 Issue[]                 @relation("UserIssues")
  policyAgreements       UserPolicyAgreement[]
  role                   UserRole                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId                 String                  @default("member")
  applications           Application[]
  feedback               Feedback[]
}

model UserRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  users       User[]
}

model UserPolicyAgreement {
  id         String    @id @default(cuid())
  userId     String
  policyName String
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, policyName])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProgress {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  completed     Boolean   @default(false)
  reviewed      Boolean   @default(false)
  lastAttempted DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question  @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Question {
  id               Int               @id @default(autoincrement())
  exam             String
  questionId       String            @unique
  text             String
  subject          String
  topic            String
  subtopic         String
  difficulty       String
  type             String
  year             Int
  reviewed         Boolean
  completed        Boolean
  options          String[]
  correctOption    String
  markscheme       String
  marks            String?
  correctAttempts  String?
  wrongAttempts    String?
  averageTimeTaken String?
  lastAttempted    DateTime?
  diagramUrl       String?
  notes            Note[]            @relation("QuestionNotes")
  progresses       UserProgress[]
  answers          UserAnswer[]
  userPerformances UserPerformance[]
  status           QuestionStatus    @default(ACTIVE)
  issues           Issue[]

  @@index([status])
}

enum QuestionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String    @db.Text
  type       NoteType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation("QuestionNotes", fields: [questionId], references: [questionId], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
}

enum NoteType {
  TEXT
  IMAGE
  STYLUS
  VOICE
}

model UserPerformance {
  id                      Int      @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question                Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserAnswer {
  id             String   @id @default(cuid())
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  username String
  email    String
  bio      String
  urls     Json
  name     String
  language String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomQuestionBank {
  id              String           @id @default(uuid())
  name            String
  description     String
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customQuestions CustomQuestion[] @relation("CustomQuestionBankQuestions")
}

model CustomNote {
  id         String         @id @default(cuid())
  content    String?
  userId     String
  questionId String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade, name: "CustomQuestionNotes")

  @@unique([userId, questionId])
}

model CustomUserProgress {
  id            String         @id @default(cuid())
  userId        String
  questionId    String
  completed     Boolean        @default(false)
  reviewed      Boolean        @default(false)
  lastAttempted DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CustomUserAnswer {
  id             String         @id @default(cuid())
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CustomUserPerformance {
  id                      Int            @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question                CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CustomQuestion {
  id                   Int                     @id @default(autoincrement())
  exam                 String
  questionId           String                  @unique
  text                 String
  subject              String
  topic                String
  subtopic             String
  difficulty           String
  type                 String
  year                 Int
  reviewed             Boolean
  completed            Boolean
  options              String[]
  correctOption        String
  markscheme           String
  marks                String?
  correctAttempts      String?
  wrongAttempts        String?
  averageTimeTaken     String?
  lastAttempted        DateTime?
  diagramUrl           String?
  notes                CustomNote[]            @relation("CustomQuestionNotes")
  progresses           CustomUserProgress[]
  answers              CustomUserAnswer[]
  userPerformances     CustomUserPerformance[]
  customQuestionBankId String?
  customQuestionBank   CustomQuestionBank?     @relation(fields: [customQuestionBankId], references: [id], onDelete: Cascade, name: "CustomQuestionBankQuestions")
}

model Issue {
  id          String       @id @default(cuid())
  title       String
  description String
  status      IssueStatus  @default(OPEN)
  priority    IssuePriority
  area        IssueArea
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade, name: "UserIssues")
  questionId  String?
  question    Question?    @relation(fields: [questionId], references: [questionId], onDelete: SetNull)
}

enum IssueArea {
  CONTENT
  UI
  BUG
  FEATURE
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  name       String
  email      String
  role       ApplicationRole
  experience String
  motivation String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
}

enum ApplicationRole {
  VOLUNTEER
  MODERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  emoji     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model GoalAspirantsQuestion {
  id               Int       @id @default(autoincrement())
  questionId       String    @unique
  exam             String
  text             String
  subject          String
  topic            String?   // Combined from ExamGoal's `chapter` and `topicName`
  subtopic         String?   // Additional granularity, from ExamGoal's `chapterGroup`
  difficulty       String?   // Difficulty level, e.g., "Easy", "Medium", "Hard"
  type             String    // Question type, e.g., "mcq", "integer"
  year             Int       // Year of the exam
  marks            Float?    // Marks for the question
  negMarks         Float?    // Negative marks for incorrect answers
  correctOptions   String[]  // Correct options, from ExamGoal's `correct_options`
  explanation      String?   // Explanation or solution for the question
  markscheme       String?   // Additional marking scheme details
  subjectGroup     String?   // Optional, for grouping subjects (e.g., "Sciences")
  diagramUrl       String?   // URL for any associated diagrams
  answer           String?   // For integer-type questions with direct answers
  isOutOfSyllabus  Boolean   @default(false) // Indicates if the question is out of syllabus
  isBonus          Boolean   @default(false) // Indicates if the question is a bonus question
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  options          GoalOption[] @relation("GoalQuestionOptions") // Relation to GoalOption model

  @@index([exam, subject]) // Index for optimized queries
}

model GoalOption {
  id           Int       @id @default(autoincrement())
  identifier   String    // Option identifier, e.g., "A", "B"
  content      String    // Option content
  questionId   Int       // Relational ID to the GoalAspirantsQuestion
  question     GoalAspirantsQuestion @relation("GoalQuestionOptions", fields: [questionId], references: [id]) // Backward relation

  @@unique([questionId, identifier]) // Ensure options are unique for each question
}
