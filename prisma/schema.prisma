generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                     String                  @id @default(cuid())
  name                   String?
  email                  String?                 @unique
  emailVerified          DateTime?
  image                  String?
  subscribed             Boolean                 @default(false)
  accounts               Account[]
  sessions               Session[]
  progresses             UserProgress[]
  notes                  Note[]
  performances           UserPerformance[]
  answers                UserAnswer[]
  settings               UserSettings?
  questionBanks          CustomQuestionBank[]
  customNotes            CustomNote[]
  customUserProgresses   CustomUserProgress[]
  customUserAnswers      CustomUserAnswer[]
  customUserPerformances CustomUserPerformance[]
  issues                 Issue[]                 @relation("UserIssues")
  policyAgreements       UserPolicyAgreement[]
  role                   UserRole                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId                 String                  @default("member")
  applications           Application[]
  feedback               Feedback[]
}

model UserRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json
  users       User[]
}

model UserPolicyAgreement {
  id         String    @id @default(cuid())
  userId     String
  policyName String
  accepted   Boolean   @default(false)
  acceptedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, policyName])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProgress {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  completed     Boolean   @default(false)
  reviewed      Boolean   @default(false)
  lastAttempted DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question  @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Question {
  id                   Int               @id @default(autoincrement())
  questionId           String            @unique
  examGroup            String?           // e.g., "jee", "medical"
  country              String?           // Country code, e.g., "in"
  exam                 String?           // Exam identifier, e.g., "jee-main"
  key                  String?           // Unique key for the question
  date                 DateTime?         // Exam date
  description          String?           // Description of the question or exam
  isMemoryBased        Boolean?          // Indicates if the question is memory-based
  isOnline             Boolean?          // Indicates if the question is from an online exam
  languages            String[]          // Supported languages (required list)
  title                String?           // Title of the exam or question
  year                 Int?              // Year of the exam
  pyqOutOfSyllabus     Int?              // Out-of-syllabus question count
  pyqTotal             Int?              // Total questions in the exam
  pyqPrivate           Int?              // Private questions count
  pyqPublic            Int?              // Public questions count

  // Additional fields inferred from user logs/data
  examId               Int?              // Foreign key referencing the Exam model
  subjectGroup         String?
  chapterGroup         String?
  chapter              String?
  topicName            String?
  examDate             DateTime?         // If distinct from `date`
  content              Json?             // Complex question content (HTML, structured data)
  permalink            String?
  paperId              String?
  isOutOfSyllabus      Boolean?
  isBonus              Boolean?

  // Question-specific fields
  text                 String            // Question text (required)
  subject              String?           // Subject of the question
  topic                String?           // Topic name
  subtopic             String?           // Subtopic for additional granularity
  difficulty           String?           // Difficulty level
  type                 String?           // Question type, e.g., "mcq", "integer"
  marks                Float?            // Marks assigned
  negMarks             Float?            // Negative marks for incorrect answers
  options              String[]          // List of options (required list)
  correctOption        String?           // Correct option
  markscheme           String?           // Marking scheme details
  correctAttempts      String?           // Number of correct attempts
  wrongAttempts        String?           // Number of wrong attempts
  averageTimeTaken     String?           // Average time taken to solve
  lastAttempted        DateTime?         // Last attempted date
  diagramUrl           String?           // URL for diagrams, if any
  customTag            String?           // Custom tag for user-defined grouping
  explanation          Json?             // JSON object for explanation details
  reviewed             Boolean?          // Whether the question has been reviewed
  completed            Boolean?          // Whether the question is marked as completed

  // Additional metadata
  paperTitle           String?           // Title of the paper the question belongs to
  timeAllotted         Int?              // Time allotted for the question
  updatedTime          Int?              // Timestamp for last update
  updatedBy            String?           // ID or name of the user/admin who last updated the question
  source               String?           // Source of the question, e.g., "official paper", "mock test"
  peerSolvedPercentage Float?            // Percentage of peers who solved the question correctly
  linkedResources      Json?             // Links to additional resources for understanding the concept
  commonMistakes       Json?             // JSON object for common mistakes and explanations
  discussionLink       String?           // URL for discussion forum or thread
  parentQuestionId     Int?              // If part of a composite question, reference parent question
  difficultyRating     Float?            // Difficulty rating: Easy, Medium, Hard, Very Hard

  // Additional fields
  yearKey              String?           // Unique key for the year of the question
  status               QuestionStatus    @default(ACTIVE) // Status of the question
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  notes                Note[]            @relation("QuestionNotes")
  progresses           UserProgress[]
  answers              UserAnswer[]
  userPerformances     UserPerformance[]
  issues               Issue[]

  // Relation to Exam model
  examModel            Exam?             @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum QuestionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Note {
  id         String    @id @default(cuid())
  title      String
  content    String    @db.Text
  type       NoteType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation("QuestionNotes", fields: [questionId], references: [questionId], onDelete: SetNull)

  @@index([userId])
  @@index([questionId])
}

enum NoteType {
  TEXT
  IMAGE
  STYLUS
  VOICE
}

model Exam {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  examGroup     String?
  country       String?
  exam          String?
  date          DateTime?
  description   String?
  isMemoryBased Boolean?
  isOnline      Boolean?
  languages     String[]
  title         String
  year          Int?

  pyq           Pyq[]

  questions     Question[]
  @@index([key])
}

model Pyq {
  id              Int    @id @default(autoincrement())
  out_of_syllabus Int?
  total           Int?
  private         Int?
  public          Int?
  examId          Int

  exam            Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model UserPerformance {
  id                      Int      @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question                Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserAnswer {
  id             String   @id @default(cuid())
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  username String
  email    String
  bio      String
  urls     Json
  name     String
  language String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomQuestionBank {
  id              String           @id @default(uuid())
  name            String
  description     String
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customQuestions CustomQuestion[] @relation("CustomQuestionBankQuestions")
}

model CustomNote {
  id         String         @id @default(cuid())
  content    String?
  userId     String
  questionId String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade, name: "CustomQuestionNotes")

  @@unique([userId, questionId])
}

model CustomUserProgress {
  id            String         @id @default(cuid())
  userId        String
  questionId    String
  completed     Boolean        @default(false)
  reviewed      Boolean        @default(false)
  lastAttempted DateTime?
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CustomUserAnswer {
  id             String         @id @default(cuid())
  questionId     String
  userId         String
  selectedOption String
  isCorrect      Boolean
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CustomUserPerformance {
  id                      Int            @id @default(autoincrement())
  userId                  String
  questionId              String
  correctAnswers          Int
  incorrectAnswers        Int
  uniqueQuestions         Int
  questionsAttempted      Int
  timeSpent               Int
  accuracy                Float
  weaknessBySubtopic      Json
  improvementOverTime     Json
  attemptRate             Float
  firstAttemptSuccessRate Float
  reattemptAccuracy       Float
  topicPerformance        Json
  consistency             Float
  engagementLevel         Float
  completed               Boolean
  reviewed                Boolean
  lastAttempted           DateTime
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question                CustomQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@unique([userId, questionId])
}

model CustomQuestion {
  id                   Int                     @id @default(autoincrement())
  exam                 String
  questionId           String                  @unique
  text                 String
  subject              String
  topic                String
  subtopic             String
  difficulty           String
  type                 String
  year                 Int
  reviewed             Boolean
  completed            Boolean
  options              String[]
  correctOption        String
  markscheme           String
  marks                String?
  correctAttempts      String?
  wrongAttempts        String?
  averageTimeTaken     String?
  lastAttempted        DateTime?
  diagramUrl           String?
  notes                CustomNote[]            @relation("CustomQuestionNotes")
  progresses           CustomUserProgress[]
  answers              CustomUserAnswer[]
  userPerformances     CustomUserPerformance[]
  customQuestionBankId String?
  customQuestionBank   CustomQuestionBank?     @relation(fields: [customQuestionBankId], references: [id], onDelete: Cascade, name: "CustomQuestionBankQuestions")
}

model Issue {
  id          String       @id @default(cuid())
  title       String
  description String
  status      IssueStatus  @default(OPEN)
  priority    IssuePriority
  area        IssueArea
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade, name: "UserIssues")
  questionId  String?
  question    Question?    @relation(fields: [questionId], references: [questionId], onDelete: SetNull)
}

enum IssueArea {
  CONTENT
  UI
  BUG
  FEATURE
  OTHER
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  name       String
  email      String
  role       ApplicationRole
  experience String
  motivation String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([id, userId])
}

enum ApplicationRole {
  VOLUNTEER
  MODERATOR
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id        String   @id @default(cuid())
  content   String
  emoji     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

